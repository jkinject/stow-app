# 로컬 개발: npx supabase start 후 npx supabase status 의 값
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=<anon key>

# ───────────────────────────────────────────────────────────────
# 아래는 **.env.production.local** 에 둔다 (gitignore 됨, chmod 600)
# ───────────────────────────────────────────────────────────────
# SUPABASE_DB_PASSWORD=<원격 DB 비밀번호>
# SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=<구글 OAuth 클라이언트 ID>
# SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=<구글 OAuth 시크릿>

# 매직링크 메일 발송 (Resend)
#   config.toml 의 [remotes.production.auth.email.smtp] 가 env(...) 로 참조한다.
#   반영: ./scripts/push-auth-config.sh
#
#   ⚠ RESEND_SENDER 는 Resend 에서 **인증한 도메인**의 주소여야 한다.
#     도메인 인증 전에는 onboarding@resend.dev 만 쓸 수 있고,
#     그건 Resend 계정 주인 본인에게만 도착한다.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# RESEND_SENDER=no-reply@yourdomain.com
