# 로컬 개발: npx supabase start 후 npx supabase status 의 값
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=<anon key>

# ───────────────────────────────────────────────────────────────
# 아래는 **.env.production.local** 에 둔다 (gitignore 됨, chmod 600)
# ───────────────────────────────────────────────────────────────
# SUPABASE_DB_PASSWORD=<원격 DB 비밀번호>
# SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=<구글 OAuth 클라이언트 ID>
# SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=<구글 OAuth 시크릿>

# 매직링크 메일 발송 (Resend)
#   config.toml 의 [remotes.production.auth.email.smtp] 가 env(...) 로 참조한다.
#   반영: ./scripts/push-auth-config.sh
#
#   ⚠ RESEND_SENDER 는 Resend 에서 **인증한 도메인**의 주소여야 한다.
#     도메인 인증 전에는 onboarding@resend.dev 만 쓸 수 있고,
#     그건 Resend 계정 주인 본인에게만 도착한다.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# RESEND_SENDER=no-reply@yourdomain.com

# 휴면 집 정리 작업 (Edge Function `household-lifecycle`)
#   cron 이 그 함수를 부를 때 쓰는 확인용 비밀. 임의의 긴 문자열이면 된다.
#   ⚠ **세 곳에 같아야** 한다: 이 파일 · Edge Function secrets · DB vault.
#     손으로 옮기면 어긋나고, 어긋나면 cron 이 403 으로 튕기는데 **아무 오류도 안 난다** —
#     정리가 영원히 안 돌 뿐이라 알아채기 어렵다. ./scripts/deploy-lifecycle.sh 가 셋을 맞춘다.
#   만들기:
#     printf 'STOW_CRON_SECRET=%s\n' "$(openssl rand -base64 36 | tr -d '\n/+=' | cut -c1-40)" \
#       >> .env.production.local
# STOW_CRON_SECRET=<임의의 긴 문자열>

# Play Store 업로드 자동화 (scripts/play.mjs)
#   ⚠ 이 JSON 하나면 앱을 스토어에 배포할 수 있다. 업로드 키스토어와 같은 급으로 다룰 것.
#     저장소 밖(~/keystores/)에 두고 chmod 600.
#   만드는 법: docs/play-store-checklist.md 의 "업로드 자동화"
# GOOGLE_PLAY_SERVICE_ACCOUNT=~/keystores/play-service-account.json
