{
  "expo": {
    "name": "Stow",
    "slug": "stow",
    "version": "1.1.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "stow",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "net.jangstar.stow",
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#AFB1C9",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "net.jangstar.stow",
      "versionCode": 3,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.CAMERA"
      ],
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180
        }
      ],
      "expo-web-browser",
      "expo-apple-authentication",
      [
        "expo-camera",
        {
          "cameraPermission": "Stow uses the camera to photograph an item so you can see where you put it.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Stow uses your photo library so you can pick an existing photo of an item.",
          "cameraPermission": "Stow uses the camera to photograph an item so you can see where you put it.",
          "microphonePermission": false
        }
      ],
      "expo-sharing",
      "./plugins/withKoreanAppName",
      "./plugins/withReleaseSigning",
      "expo-localization",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ab3e4a13-9fff-470c-bdbb-0f940bfaba22"
      }
    },
    "owner": "jkinject",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "requestHeaders": {
        "expo-channel-name": "production"
      },
      "url": "https://u.expo.dev/ab3e4a13-9fff-470c-bdbb-0f940bfaba22"
    },
    "locales": {
      "en": "./locales/en.json",
      "ko": "./locales/ko.json"
    }
  }
}
